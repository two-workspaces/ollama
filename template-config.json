{
  "services": {
    "9e59963f-eea8-4b95-ba6c-b7750c1cd4ed": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/ollama/main/icon.png",
      "name": "Ollama",
      "build": {
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/healthz",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/two-workspaces/ollama",
        "rootDirectory": null
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>:8080": {
            "port": 8080
          }
        },
        "tcpProxies": {}
      },
      "volumeMounts": {
        "630d22d5-7d55-4ad3-86ad-23b7e60c5c81": {
          "mountPath": "/root/.ollama"
        }
      },
      "variables": {
        "OLLAMA_API_KEY": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Bearer token for the public Ollama API (Open WebUI uses the private network and doesn't need it)",
          "isOptional": false
        },
        "OLLAMA_PULL_MODELS": {
          "defaultValue": "llama3.2:3b,nomic-embed-text",
          "description": "Models pulled at boot, comma-separated (ollama.com/library names)",
          "isOptional": true
        },
        "OLLAMA_NUM_THREADS": {
          "defaultValue": "",
          "description": "CPU threads per model; empty = your plan's vCPU quota",
          "isOptional": true
        },
        "PORT": {
          "defaultValue": "8080",
          "description": "Port Railway routes to - leave as is",
          "isOptional": false
        }
      }
    },
    "42438626-4578-4322-8834-d7d411c88b09": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/ollama/main/open-webui.png",
      "name": "Open WebUI",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/open-webui/open-webui:v0.12.3"
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>:8080": {
            "port": 8080
          }
        },
        "tcpProxies": {}
      },
      "volumeMounts": {
        "46ece8a0-09eb-4860-be54-a15ecfee65e2": {
          "mountPath": "/app/backend/data"
        }
      },
      "variables": {
        "WEBUI_ADMIN_EMAIL": {
          "defaultValue": "admin@example.com",
          "description": "Admin login email, created on first boot (change it later in Settings)",
          "isOptional": false
        },
        "WEBUI_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Admin password, created on first boot",
          "isOptional": false
        },
        "WEBUI_SECRET_KEY": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs login sessions",
          "isOptional": false
        },
        "WEBUI_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL of Open WebUI",
          "isOptional": false
        },
        "OLLAMA_BASE_URL": {
          "defaultValue": "http://${{Ollama.RAILWAY_PRIVATE_DOMAIN}}:11434",
          "description": "Ollama over Railway's private network",
          "isOptional": false
        },
        "RAG_EMBEDDING_ENGINE": {
          "defaultValue": "ollama",
          "description": "Document embeddings run in Ollama instead of a second model inside Open WebUI",
          "isOptional": false
        },
        "RAG_EMBEDDING_MODEL": {
          "defaultValue": "nomic-embed-text",
          "description": "Ollama embedding model (must be in OLLAMA_PULL_MODELS)",
          "isOptional": false
        },
        "PORT": {
          "defaultValue": "8080",
          "description": "Port Railway routes to - leave as is",
          "isOptional": false
        },
        "RAILWAY_HEALTHCHECK_TIMEOUT_SEC": {
          "defaultValue": "600",
          "description": "First boot runs database migrations",
          "isOptional": false
        }
      }
    }
  }
}